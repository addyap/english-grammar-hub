{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "destination": "https://www.antonyaddy.com/grammatica",
      "permanent": true
    },
    {
      "source": "/:path((?!grammatica(?:/|$)|_vercel/).+)",
      "destination": "https://www.antonyaddy.com/grammatica/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/grammatica/(.*)",
      "destination": "/grammatica/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    }
  ]
}
